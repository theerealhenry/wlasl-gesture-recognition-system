# =============================================================================
# WLASL Gesture Recognition — .gitignore
# =============================================================================
# This file excludes:
#   - Large data files (videos, cached landmarks) — too large for git
#   - ML experiment stores (MLflow) — regenerated by running pipelines
#   - Trained model binaries — tracked via MLflow model registry instead
#   - Runtime logs — generated fresh per run
#   - Python/OS/IDE cache files
# =============================================================================


# =============================================================================
# PROJECT-SPECIFIC — Data and Models
# =============================================================================

# Raw downloaded WLASL videos — can be 10–50 GB, never commit
data/raw/

# Cached MediaPipe landmark arrays (.npy) — regenerated by run_preprocessing.py
data/landmarks/

# Trained model SavedModel directories and weights
# Track model versions via MLflow Model Registry instead
models/gesture_*/
models/*.h5
models/*.pb
models/*.ckpt
models/*.ckpt.*
models/*.index
models/*.data-*
models/

# TFLite export — commit only the final champion model if < 10 MB
# Uncomment the line below to also exclude .tflite files:
# models/*.tflite

# MLflow experiment store — regenerated by running experiments
mlruns/
mlartifacts/

# Runtime logs — generated fresh per run
logs/

# Per-run experiment artefact snapshots
artifacts/experiments/

# Preprocessing intermediate files
data/preprocessing_summary.json
data/data_validation_report.json


# =============================================================================
# PYTHON
# =============================================================================

# Byte-compiled / optimised / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytest-cache/


# =============================================================================
# JUPYTER NOTEBOOKS
# =============================================================================

# Notebook checkpoints (auto-saved state, not useful in git)
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Jupyter runtime files
.jupyter/
jupyter_execute/

# Notebook outputs can be large — strip outputs before committing
# Use: jupyter nbconvert --clear-output --inplace notebooks/*.ipynb
# (outputs are reproduced by running the notebook)


# =============================================================================
# VIRTUAL ENVIRONMENTS
# =============================================================================

# Conda environments
.conda/
envs/

# Virtualenv / venv
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# pyenv
.python-version


# =============================================================================
# ENVIRONMENT AND SECRETS
# =============================================================================

# Environment variable files — NEVER commit API keys or credentials
.env
.env.*
*.env
secrets.yaml
secrets.json
credentials.json

# AWS, GCP, Azure credentials
.aws/
.gcp/
.azure/


# =============================================================================
# TENSORFLOW / KERAS
# =============================================================================

# TensorBoard logs
runs/
events.out.tfevents.*
tb_logs/

# Keras tuner results
keras_tuner/
my_dir/

# TF serving cache
saved_model_cache/


# =============================================================================
# MEDIAPIPE
# =============================================================================

# MediaPipe model files (downloaded automatically at runtime)
*.task
*.tflite.tmp


# =============================================================================
# DOCKER
# =============================================================================

# Docker build context cache
.dockerignore.bak

# Docker volumes (if using local bind mounts in dev)
docker-volumes/


# =============================================================================
# OPERATING SYSTEM
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~


# =============================================================================
# EDITORS AND IDEs
# =============================================================================

# VS Code
.vscode/
!.vscode/settings.json          # Keep shared team settings if desired
!.vscode/extensions.json        # Keep recommended extensions
*.code-workspace

# PyCharm / JetBrains
.idea/
*.iml
*.iws
*.ipr

# Vim / Neovim
*.swp
*.swo
*~
.netrwhist

# Emacs
\#*\#
.\#*
*.elc

# Sublime Text
*.sublime-project
*.sublime-workspace

# Spyder
.spyderproject.cfg
.spyproject/


# =============================================================================
# MISCELLANEOUS
# =============================================================================

# Byte Order Mark (BOM)
*.bom

# Compiled documentation
docs/_build/
docs/site/

# Generated figures — keep committed (they are project outputs)
# Uncomment below to exclude if figures are very large
# reports/figures/

# Temporary files
*.tmp
*.bak
*.orig
*.rej

# Archives
*.zip
*.tar.gz
*.tar.bz2
*.rar
*.7z

# Large binary files
*.mp4
*.avi
*.mov
*.mkv

# project outline doc
*docx

outputs/

